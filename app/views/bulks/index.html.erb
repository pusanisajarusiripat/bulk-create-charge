<h1>Bulks</h1>
<%= link_to "Import new bulk", new_bulk_path, class: "btn btn-secondary" %>

<table class="table">
  <thead>
    <tr>
      <th>ID</th>
      <th>Status</th>
      <th>Amount of Charges</th>
      <th>Created At</th>
      <th>File</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody id="bulks">
    <%= render @bulks %>
  </tbody>
</table>