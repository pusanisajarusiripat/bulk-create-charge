<%= link_to "Back", "javascript:history.back()", class: "btn btn-secondary" %>
<h1>Bulk Import Details </h1>
<% if @bulk.file.attached? %>
<h2>Bulk Id: <%= @bulk.id %> </h2>
<table class="bulk-table">
  <thead>
    <tr>
      <th>Charge Id</th>
      <th>Currency</th>
      <th>Amount</th>
      <th>Status</th>
      <th>Created At</th>
      <th>Action</th>
    </tr>
  </thead>
  <tbody id="charges">
    <%= render @bulk.charges %>
  </tbody>
</table>

<% end %>