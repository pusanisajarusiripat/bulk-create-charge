<%= link_to "Back", "javascript:history.back()", class: "btn btn-secondary" %>
<h1>Import Charges</h1>

<p>
  For your convenience, you can download our template file:
  <%= link_to "Download Excel Template (XLSX)", "/templates/bulk_create_template.xlsx", download: "bulk_create_template.xlsx" %>
</p>
<p>
  After filling out the template, please save the file as a <strong>CSV</strong> before uploading.
</p>

<%= form_with(model: @bulk, multipart: true) do |form| %>
  <div class="field">
    <%= form.label :file, "Upload File (CSV)" %>
    <%= form.file_field :file %>
    <% @bulk.errors.full_messages_for(:file).each do |message| %>
      <div><%= message %></div>
    <% end %>    
  </div>

  <div class="actions" style="margin-top: 30px;">
    <%= form.submit "Import" %>
  </div>
<% end %>