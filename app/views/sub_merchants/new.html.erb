<h1>New Submerchant</h1>

<%= form_with(model: @sub_merchant) do |form| %>
  <div>
    <%= form.label :name %><br>
    <%= form.text_field :name, required: true %>
  </div>

  <div>
    <%= form.label :city %><br>
    <%= form.text_field :city, required: true %>
  </div>

    <div class="actions" style="margin-top: 30px;">

    <%= form.submit "Create Submerchant" %>
  </div>
<% end %>