<!-- filepath: app/views/layouts/application.html.erb -->
<!DOCTYPE html>
<html>
  <head>
    <title>BulkCreateCharge</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
  </head>

  <body>
    <div style="display: flex; min-height: 100vh;">
      <!-- Sidebar -->
      <nav style="width: 220px; background: #f8f9fa; padding: 2rem 1rem;">
        <h3>Menu</h3>
        <ul style="list-style: none; padding: 0;">
          <li><%= link_to "All Bulks", bulks_path %></li>
          <li><%= link_to "All Charges", charges_path %></li>
          <li><%= link_to "All Submerchants", sub_merchants_path %></li>
        </ul>
      </nav>

      <!-- Main content -->
      <main style="flex: 1; padding: 2rem;">
        <%= yield %>
      </main>
    </div>
  </body>
</html>